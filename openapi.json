{
  "openapi": "3.1.0",
  "info": {
    "title": "brzask",
    "summary": "Self-hosted daily news digest.",
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "List pipeline runs",
        "description": "Runs newest first, including ones still running.",
        "operationId": "get_runs_api_v1_runs_get",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RunKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only runs of this pipeline.",
              "title": "Kind"
            },
            "description": "Only runs of this pipeline."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Items per page.",
              "default": 50,
              "title": "Limit"
            },
            "description": "Items per page."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` of the previous page; leave out for the first page.",
              "title": "Cursor"
            },
            "description": "`next_cursor` of the previous page; leave out for the first page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_RunOut_"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "The process is up",
        "description": "Answers as long as the process serves requests; touches nothing else.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "The process can serve the API",
        "description": "The database answers and its schema is at the latest migration.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FieldError": {
        "properties": {
          "location": {
            "description": "Where the invalid value is, e.g. [\"query\", \"limit\"].",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "description": "Machine-readable kind of error, e.g. \"less_than_equal\".",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "Page_RunOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor",
            "description": "Pass as `cursor` for the next page; null on the last page."
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "Page[RunOut]"
      },
      "Problem": {
        "properties": {
          "type": {
            "default": "about:blank",
            "description": "URI of the problem type; about:blank means the status says it all.",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "description": "Short summary of the problem type.",
            "title": "Title",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "What went wrong in this case.",
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Path of the request.",
            "title": "Instance"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Invalid fields (status 422).",
            "title": "Errors"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RunKind": {
        "type": "string",
        "enum": [
          "digest",
          "review",
          "visited",
          "discovery"
        ],
        "title": "RunKind"
      },
      "RunOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "$ref": "#/components/schemas/RunKind"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "stats": {
            "additionalProperties": true,
            "type": "object",
            "title": "Stats"
          },
          "timings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Timings"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "dry_run",
          "started_at",
          "finished_at",
          "stats",
          "timings",
          "error"
        ],
        "title": "RunOut"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "running",
          "ok",
          "skipped",
          "failed"
        ],
        "title": "RunStatus"
      }
    }
  }
}
