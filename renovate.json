{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesMonthly"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "One weekly PR per ecosystem for minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "{{manager}} minor and patch updates",
      "groupSlug": "{{manager}}-minor-patch"
    },
    {
      "description": "pnpm is pinned in mise.toml and in frontend/package.json (packageManager); update both in one PR",
      "matchDepNames": [
        "pnpm"
      ],
      "groupName": "pnpm",
      "groupSlug": "pnpm"
    },
    {
      "description": "Python versions are upgraded deliberately (3.13 to 3.14 is a new language version)",
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Node major versions are upgraded deliberately; @types/node follows the Node major in use",
      "matchDepNames": [
        "node",
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "typescript-eslint supports TypeScript only below 6.1",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "MkDocs 2.0 drops the plugin and theme system that Material for MkDocs needs",
      "matchPackageNames": [
        "mkdocs"
      ],
      "allowedVersions": "<2"
    }
  ]
}
