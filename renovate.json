{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesMonthly"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "One weekly PR per ecosystem for minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "{{manager}} minor and patch updates",
      "groupSlug": "{{manager}}-minor-patch"
    },
    {
      "description": "Toolchain runtimes move together with mise.toml, CI and the devcontainer",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "python",
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "typescript-eslint supports TypeScript only below 6.1",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6.1.0"
    }
  ]
}
