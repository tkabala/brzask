# brzask configuration.
#
# Copy to .env and adjust. Commented lines show the default value.
# Every secret can also be read from a file: set <NAME>_FILE=/path/to/file.
#
# Generated from backend/src/brzask/config/settings.py by `just env-example`.

# Database: Postgres 17 with the pgvector extension.
# Postgres host.
# DB_HOST=localhost
# Postgres port.
# DB_PORT=5432
# Database name.
# DB_NAME=brzask
# Database user.
# DB_USER=brzask
# Database password. Or DB_PASSWORD_FILE.
DB_PASSWORD=brzask

# LLM: any OpenAI-compatible chat completions API.
# Base URL of the OpenAI-compatible API (OpenRouter, Ollama, ...).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Model used for ranking and selection.
# LLM_MODEL=deepseek/deepseek-v4-flash
# API key; leave empty for local servers. Or LLM_API_KEY_FILE.
LLM_API_KEY=

# Embeddings: any OpenAI-compatible /embeddings API.
# Base URL of the embeddings API; defaults to LLM_BASE_URL.
# EMBEDDING_BASE_URL=
# Embedding model.
# EMBEDDING_MODEL=google/gemini-embedding-001
# API key; defaults to LLM_API_KEY. Or EMBEDDING_API_KEY_FILE.
EMBEDDING_API_KEY=

# Article text extraction.
# Extractors tried in order; the feed snippet is the final fallback.
# EXTRACTORS=feed,trafilatura,jina
# Jina Reader API key; optional, raises rate limits. Or JINA_API_KEY_FILE.
JINA_API_KEY=
# Firecrawl API URL; change it for a self-hosted instance.
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/
# Firecrawl API key; required for the hosted service. Or FIRECRAWL_API_KEY_FILE.
FIRECRAWL_API_KEY=
# Crawl4AI server URL; required when crawl4ai is enabled.
# CRAWL4AI_BASE_URL=

# Web search used by source discovery.
# searxng, llm-online or brave; empty runs discovery without web search.
# WEB_SEARCH=
# SearXNG instance URL (JSON format must be enabled).
# SEARXNG_URL=
# Brave Search API key. Or BRAVE_API_KEY_FILE.
BRAVE_API_KEY=
# Online model used by llm-online, through the LLM API.
# WEB_SEARCH_MODEL=perplexity/sonar

# Authentication for the web UI and API.
# password, header (trust a reverse proxy) or none (no login, local use only).
# AUTH_MODE=password
# Argon2 hash of the login password (mode=password). Or AUTH_PASSWORD_HASH_FILE.
AUTH_PASSWORD_HASH=
# Random string of at least 32 characters that signs sessions. Or AUTH_SESSION_SECRET_FILE.
AUTH_SESSION_SECRET=
# Header with the user name (mode=header).
# AUTH_HEADER=Remote-User
# Comma-separated proxy addresses or networks allowed to set the header.
# TRUSTED_PROXIES=

# Pipeline schedule for the worker. 'HH:MM' runs daily, '<mon..sun> HH:MM' weekly,
# 'off' never.
# When the daily digest is built.
# DIGEST_AT=07:00
# When sources are reviewed.
# REVIEW_AT=mon 07:30
# When opened links are checked for new sources.
# VISITED_AT=mon 07:45
# When new sources are searched for.
# DISCOVERY_AT=mon 08:00
# Time zone of the schedule and digest dates.
# TZ=UTC

# Digest output.
# Language of digest titles and summaries.
# DIGEST_LANGUAGE=en

# LLM spending limits; above a limit, expensive steps are skipped.
# Daily limit in USD; empty for none.
# LLM_BUDGET_DAILY_USD=
# Monthly limit in USD; empty for none.
# LLM_BUDGET_MONTHLY_USD=
