# brzask configuration.
#
# Copy to .env and adjust. Commented lines show the default value.
# Every secret can also be read from a file: set <NAME>_FILE=/path/to/file.
#
# Generated from backend/src/brzask/config/settings.py by `just env-example`.

# Database: Postgres 17 with the pgvector extension.
# Postgres host.
# DB_HOST=localhost
# Postgres port.
# DB_PORT=5432
# Database name.
# DB_NAME=brzask
# Database user.
# DB_USER=brzask
# Database password. Or DB_PASSWORD_FILE.
DB_PASSWORD=brzask

# LLM: any OpenAI-compatible chat completions API.
# Base URL of the OpenAI-compatible API (OpenRouter, Ollama, ...).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Model used for ranking and selection.
# LLM_MODEL=deepseek/deepseek-v4-flash
# API key; leave empty for local servers. Or LLM_API_KEY_FILE.
LLM_API_KEY=
# How long one request may take; ranking prompts are long.
# LLM_TIMEOUT_SECONDS=300

# Embeddings: any OpenAI-compatible /embeddings API.
# Base URL of the embeddings API; defaults to LLM_BASE_URL.
# EMBEDDING_BASE_URL=
# Embedding model; `brzask reembed` moves stored vectors to another one.
# EMBEDDING_MODEL=google/gemini-embedding-001
# API key; defaults to LLM_API_KEY. Or EMBEDDING_API_KEY_FILE.
EMBEDDING_API_KEY=

# Judgements: short typed questions (yes/no, one of a set, a level) about articles.
# system-one (a System One model such as Jev or d1) or llm (the chat model answers in JSON; works with local servers).
# JUDGE_BACKEND=system-one
# Model with its author prefix; defaults to typesafe/jev-1.13 for system-one and to LLM_MODEL for llm.
# JUDGE_MODEL=
# Base URL of the API; defaults to LLM_BASE_URL.
# JUDGE_BASE_URL=
# API key; defaults to LLM_API_KEY. Or JUDGE_API_KEY_FILE.
JUDGE_API_KEY=

# Article text extraction.
# Extractors tried in order; the feed snippet is the final fallback.
# EXTRACTORS=feed,trafilatura,jina
# Jina Reader API key; optional, raises rate limits. Or JINA_API_KEY_FILE.
JINA_API_KEY=
# Firecrawl API URL; change it for a self-hosted instance.
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev/
# Firecrawl API key; required for the hosted service. Or FIRECRAWL_API_KEY_FILE.
FIRECRAWL_API_KEY=
# Crawl4AI server URL; required when crawl4ai is enabled.
# CRAWL4AI_BASE_URL=

# Web search used by source discovery.
# searxng, llm-online (recommended with OpenRouter) or brave; empty turns source discovery off.
# WEB_SEARCH=
# SearXNG instance URL (JSON format must be enabled).
# SEARXNG_URL=
# Brave Search API key. Or BRAVE_API_KEY_FILE.
BRAVE_API_KEY=
# Online model used by llm-online, through the LLM API.
# WEB_SEARCH_MODEL=perplexity/sonar

# Authentication for the web UI and API.
# password, header (trust a reverse proxy) or none (no login, local use only).
# AUTH_MODE=password
# Argon2 hash of the login password (mode=password). Or AUTH_PASSWORD_HASH_FILE.
AUTH_PASSWORD_HASH=
# Random string of at least 32 characters that signs CSRF tokens and article links. Or AUTH_SESSION_SECRET_FILE.
AUTH_SESSION_SECRET=
# Mark the session cookie Secure (sent over HTTPS only): auto when the request came over HTTPS, directly or as X-Forwarded-Proto from TRUSTED_PROXIES; true always; false never.
# AUTH_COOKIE_SECURE=auto
# Header with the user name (mode=header).
# AUTH_HEADER=Remote-User
# Comma-separated proxy addresses or networks allowed to set the header.
# TRUSTED_PROXIES=

# HTTP server of `brzask api`.
# Address to listen on; 0.0.0.0 for all.
# API_HOST=127.0.0.1
# Port to listen on.
# API_PORT=8000
# Directory of the built web app (frontend/dist) to serve at /; empty serves the API only.
# API_WEB_DIR=

# Pipeline schedule for the worker. 'HH:MM' runs daily, '<mon..sun> HH:MM' weekly,
# 'off' never.
# When the daily digest is built.
# DIGEST_AT=07:00
# When sources are reviewed.
# REVIEW_AT=mon 07:30
# When opened links are checked for new sources.
# VISITED_AT=mon 07:45
# When new sources are searched for.
# DISCOVERY_AT=mon 08:00
# Time zone of the schedule and digest dates.
# TZ=UTC

# Digest output.
# Language of digest titles and summaries.
# DIGEST_LANGUAGE=en
# llm (the LLM orders the pool) or judge (each article scored on several dimensions by JUDGE_BACKEND, weighted in code).
# DIGEST_RANKING=llm
# judge (JUDGE_BACKEND decides same-day pairs in the grey zone; the threshold if it fails) or threshold (an adaptive similarity threshold).
# DIGEST_DEDUPLICATION=judge

# LLM spending limits; above a limit, expensive steps are skipped.
# Daily limit in USD; empty for none.
# LLM_BUDGET_DAILY_USD=
# Monthly limit in USD; empty for none.
# LLM_BUDGET_MONTHLY_USD=

# Logging.
# Minimum level: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO
# json (one object per line), console (readable) or auto (console on a TTY).
# LOG_FORMAT=auto

# Traces, metrics and error reports; all off unless configured.
# OTLP/HTTP collector URL; traces and metrics are sent only when set.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name in traces.
# OTEL_SERVICE_NAME=brzask
# Sentry DSN; errors are reported only when set. Or SENTRY_DSN_FILE.
SENTRY_DSN=
# Environment name attached to Sentry reports.
# SENTRY_ENVIRONMENT=production
