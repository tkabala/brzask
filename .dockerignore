# The image is built from frontend/ and backend/ sources only.
*
!backend/pyproject.toml
!backend/uv.lock
!backend/src/
!frontend/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/storybook-static/
frontend/test-results/
frontend/playwright-report/
# Vite would build VITE_* variables from a local .env into the published app.
frontend/.env*
frontend/e2e/secrets/
**/__pycache__/
**/*.tsbuildinfo
