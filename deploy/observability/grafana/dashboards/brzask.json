    {
      "id": 2,
      "type": "timeseries",
      "title": "Runs per day",
      "description": "Finished pipeline runs by kind and outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (kind, status) (increase(brzask_pipeline_runs_total{dry_run=\"$dry_run\"}[$__interval] anchored offset -$__interval))",
          "legendFormat": "{{kind}} {{status}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "1d"
    },
